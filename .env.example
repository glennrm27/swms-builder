# --- Database ---
DATABASE_URL="postgresql://swms:swms_dev_password@localhost:5432/swms_builder?schema=public"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string-in-every-real-environment"
JWT_EXPIRES_IN="8h"

# --- Object storage ---
# STORAGE_DRIVER=local uses apps/api/storage on disk (dev default).
# STORAGE_DRIVER=azure uses Azure Blob Storage.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="swms-documents"

# --- Document generation ---
# Path to the LibreOffice binary used for DOCX -> PDF conversion.
SOFFICE_PATH="soffice"

# --- API ---
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
